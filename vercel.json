{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "APP_URL": "@app_url"
  },
  "crons": [
    {
      "path": "/api/cron/notificacion-diaria",
      "schedule": "0 2 * * *"
    }
  ]
}
